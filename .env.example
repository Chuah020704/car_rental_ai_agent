# Copy this file to .env and fill in real values. Never commit .env.

# ---- LLM Provider Selection ----
# Which chat model backs the agent. The factory in app/service/llm/llm_factory.py
# dispatches on this value. "fake" is used by the test suite (no network calls).
LLM_PROVIDER=google
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- Embeddings (RAG) ----
# "local" uses fastembed (runs on-device, no API key needed) so the grader can
# run the RAG pipeline with zero cloud credentials.
EMBEDDING_PROVIDER=local

# ---- Auth ----
# simulated: JWT minted locally against the mock customer list (matches the brief).
# entra:     real Microsoft Entra ID device-code login (practice mode, see docs/adr).
AUTH_MODE=simulated
JWT_SECRET_KEY=dev-only-change-me-replace-with-32-bytes-random-value
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# ---- Microsoft Entra ID (only read when AUTH_MODE=entra) ----
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=

# ---- Middleware / networking ----
CORS_ORIGIN=http://localhost:8501
ALLOWED_HOST=localhost;127.0.0.1

# ---- Logging ----
LOG_LEVEL=INFO
